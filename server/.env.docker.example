# Docker-Specific Environment Variables (Example)
# Copy to server/.env.docker and customize for your Docker setup
# This file overrides values from .env when using Docker Compose

# MongoDB URI for Docker Compose
# IMPORTANT: Use the service name 'mongo' for Docker Compose
# NOT 'localhost' which only works outside of Docker
MONGODB_URI=mongodb://admin:password123@mongo:27017/creators-platform?authSource=admin