# Creators Platform Root Environment Configuration
# This file is for Docker Compose variable substitution only
# Copy this to .env at the root level if you need to customize Docker ports/networking

# Docker Compose - Database Root Credentials
# These are used ONLY for MongoDB initialization in Docker
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=password123

# Docker Compose - Service Port Configuration
SERVER_PORT=5000
CLIENT_PORT=3000

# Environment flag for all services
NODE_ENV=development

# ====== IMPORTANT: Secrets and Service Config ======
# Do NOT set JWT_SECRET, CLOUDINARY_*, or MONGODB_URI here!
# Those should ONLY be in server/.env (which is .gitignored)
# See server/.env.example for the template

# For production deployments:
# - Use platform-managed secrets (AWS Secrets Manager, GitHub Secrets, etc.)
# - Never commit .env files
# - Rotate secrets regularly